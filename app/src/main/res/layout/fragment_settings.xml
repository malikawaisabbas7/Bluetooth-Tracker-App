<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:background="?attr/themeLightColor">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/themePrimaryColor" />

        <TextView
            style="@style/ToolbarTitle"
            android:layout_marginStart="12dp"
            android:text="@string/settings" />
    </LinearLayout>

    <!-- Scrollable Settings -->
    <ScrollView
        android:id="@+id/scrollSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarSize="4dp"
        android:fadeScrollbars="true"
        android:scrollbarFadeDuration="250"
        android:scrollbarDefaultDelayBeforeFade="500">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">


            <!-- App Theme: first settings option -->
            <LinearLayout
                android:id="@+id/rowAppTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp"
                android:elevation="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_theme_title"
                        android:textColor="?attr/themeTextColor"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/app_theme_desc"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSelectedTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/themeTextColor"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/themePrimaryPreview"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_theme_preview_primary" />

                        <View
                            android:id="@+id/themeLightPreview"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_theme_preview_light" />

                        <View
                            android:id="@+id/themeWhitePreview"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_theme_preview_white" />

                    </LinearLayout>

                </LinearLayout>


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="?attr/themePrimaryColor" />

            </LinearLayout>

            <!-- Language -->
            <LinearLayout
                android:id="@+id/rowLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language"
                        android:textAlignment="viewStart"
                        android:textColor="?attr/themeTextColor"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/language_desc"
                        android:textAlignment="viewStart"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="?attr/themePrimaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="?attr/themePrimaryColor" />

            </LinearLayout>

            <!-- Background Tracking -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/background_tracking"
                        android:textColor="?attr/themeTextColor"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/ivTrackingInfo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/instructions_dialog_title"
                        android:padding="10dp"
                        android:src="@drawable/ic_info_outline"
                        app:tint="?attr/themePrimaryColor" />

                    <TextView
                        android:id="@+id/tvTracking"
                        android:layout_width="50dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_toggle_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/toggle_off"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/background_tracking_desc"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Use Metric Units -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/use_metric_units"
                        android:textColor="?attr/themeTextColor"
                        android:textSize="18sp" />

                    <Spinner
                        android:id="@+id/spinnerUnit"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_spinner"
                        android:popupBackground="?attr/themeLightColor" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/unit_desc"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Scan Duration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/scan_duration"
                        android:textColor="?attr/themeTextColor"
                        android:textSize="18sp" />

                    <Spinner
                        android:id="@+id/spinnerDuration"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_spinner"
                        android:popupBackground="?attr/themeLightColor" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/scan_duration_desc"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Other Settings -->
            <TextView
                android:id="@+id/rowRemoveAds"
                style="@style/SettingsRow"
                android:text="@string/remove_ads" />

            <TextView
                android:id="@+id/rowSupport"
                style="@style/SettingsRow"
                android:text="@string/customer_support" />

            <TextView
                android:id="@+id/rowRate"
                style="@style/SettingsRow"
                android:text="@string/rate_us" />

            <TextView
                android:id="@+id/rowShare"
                style="@style/SettingsRow"
                android:text="@string/share" />

            <TextView
                android:id="@+id/rowPrivacy"
                style="@style/SettingsRow"
                android:text="@string/privacy_policy" />

            <TextView
                android:id="@+id/rowTerms"
                style="@style/SettingsRow"
                android:text="@string/terms_of_service" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

