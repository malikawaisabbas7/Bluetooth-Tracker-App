<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <!-- TOP TOOLBAR -->
    <LinearLayout
        android:id="@+id/homeToolbar"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivPremium"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/start_like_a_pro"
            android:padding="11dp"
            android:src="@drawable/diamond_icon" />

        <ImageView
            android:id="@+id/ivInstruction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/instruction"
            android:padding="11dp"
            android:src="@drawable/ic_info_outline"
            app:tint="?attr/themePrimaryColor" />

        <ImageView
            android:id="@+id/ivSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/settings"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            app:tint="?attr/themePrimaryColor" />
    </LinearLayout>

    <!-- BLUETOOTH CIRCLE -->
    <FrameLayout
        android:id="@+id/circle"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/bg_ring"
        app:layout_constraintTop_toBottomOf="@id/homeToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivBluetoothCenter"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_bluetooth"
            app:tint="?attr/themePrimaryColor" />

    </FrameLayout>

    <!-- DEVICES FOUND -->
    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:gravity="center"
        android:textColor="?attr/themeTextColor"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DEVICE CARDS -->
    <LinearLayout
        android:id="@+id/homeCards"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tags -->
        <LinearLayout
            android:id="@+id/btnAirTag"
            style="@style/HomeRow">

            <TextView
                style="@style/HomeRowLabel"
                android:text="@string/air_tag" />

            <TextView
                android:id="@+id/tvAirTagCount"
                style="@style/HomeRowCount" />

            <ImageView
                style="@style/HomeRowArrow"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>

        <!-- Bluetooth Devices -->
        <LinearLayout
            android:id="@+id/btnBluetooth"
            style="@style/HomeRow">

            <TextView
                style="@style/HomeRowLabel"
                android:text="@string/bluetooth_devices" />

            <TextView
                android:id="@+id/tvBluetoothCount"
                style="@style/HomeRowCount" />

            <ImageView
                style="@style/HomeRowArrow"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_forward" />
        </LinearLayout>

    </LinearLayout>

    <!-- START SCAN BUTTON -->
    <FrameLayout
        android:id="@+id/btnScan"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:minWidth="170dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="55dp"
        android:background="@drawable/bg_pill_intsr"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvScanLabel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="58dp"
            android:paddingEnd="20dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/start_scan"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="17sp"
            android:includeFontPadding="false" />

        <FrameLayout
            android:id="@+id/scanThumb"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_scan_button">

            <ImageView
                android:id="@+id/ivScanIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/start_scan"
                android:src="@drawable/ic_search"
                app:tint="?attr/themePrimaryColor" />

        </FrameLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
