<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft outer shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#8A9095"/>
        </shape>
    </item>

    <!-- White metallic outer rim -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FFFFFF"
                android:centerColor="#E9EAEC"
                android:endColor="#BCC2C7"/>

            <stroke
                android:width="1dp"
                android:color="#D8DDE1"/>
        </shape>
    </item>

    <!-- Main white tracker body -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">

        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#F9FAFB"
                android:centerColor="#ECEFF1"
                android:endColor="#D5DADF"/>
        </shape>
    </item>

    <!-- Subtle recessed groove -->
    <item
        android:left="17dp"
        android:top="17dp"
        android:right="17dp"
        android:bottom="17dp">

        <shape android:shape="oval">
            <solid android:color="#DCE2E6"/>

            <stroke
                android:width="1dp"
                android:color="#B7C8D0"/>
        </shape>
    </item>

    <!-- Thin pale blue circular ring -->
    <item
        android:left="19dp"
        android:top="19dp"
        android:right="19dp"
        android:bottom="19dp">

        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#F5F7F8"
                android:centerColor="#E8ECEF"
                android:endColor="#D5DBDF"/>

            <stroke
                android:width="1.5dp"
                android:color="#ADDDE8"/>
        </shape>
    </item>

</layer-list>
